<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <!-- The OpenAPI document of what the API serves, committed and diffed against the TypeSpec contract. -->
    <OpenApiGenerateDocuments>true</OpenApiGenerateDocuments>
    <OpenApiDocumentsDirectory>$(MSBuildThisFileDirectory)../../generated</OpenApiDocumentsDirectory>
    <OpenApiGenerateDocumentsOptions>--file-name openapi</OpenApiGenerateDocumentsOptions>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Microsoft.Extensions.ApiDescription.Server" PrivateAssets="all" IncludeAssets="runtime; build; native; contentfiles; analyzers; buildtransitive" />
    <PackageReference Include="WolverineFx.Http" />
    <PackageReference Include="WolverineFx.Postgresql" />
    <PackageReference Include="WolverineFx.RuntimeCompilation" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../BuildingBlocks/Raidvahkiin.Ddd.AspNetCore/Raidvahkiin.Ddd.AspNetCore.csproj" />
    <ProjectReference Include="../Cooquoi.Context.Foodpedia/Cooquoi.Context.Foodpedia.csproj" />
    <ProjectReference Include="../Cooquoi.Context.Foodventory/Cooquoi.Context.Foodventory.csproj" />
    <ProjectReference Include="../Cooquoi.Context.Household/Cooquoi.Context.Household.csproj" />
    <ProjectReference Include="../Cooquoi.Platform/Cooquoi.Platform.csproj" />
    <ProjectReference Include="../Cooquoi.ServiceDefaults/Cooquoi.ServiceDefaults.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Integration tests host the API through its Program (Alba). -->
    <InternalsVisibleTo Include="Cooquoi.Testing" />
  </ItemGroup>
</Project>
