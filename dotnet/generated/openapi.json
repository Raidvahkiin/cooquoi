{
  "openapi": "3.1.1",
  "info": {
    "title": "Cooquoi API",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://api.cooquoi.com"
    }
  ],
  "paths": {
    "/v1/me": {
      "get": {
        "tags": [
          "Cooquoi.Context.Household.Features.GetMe.GetMeEndpoint"
        ],
        "summary": "The signed-in user's profile and households, provisioned on first sign-in.",
        "description": "GET_v1_me",
        "operationId": "getMe",
        "responses": {
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1/ingredients": {
      "get": {
        "tags": [
          "Cooquoi.Context.Foodpedia.Features.SearchIngredients.SearchIngredientsEndpoint"
        ],
        "summary": "Q1: search ingredients across every locale; retired ones are visible to curators only.",
        "description": "GET_v1_ingredients",
        "operationId": "searchIngredients",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "explode": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "tags",
            "in": "query",
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          {
            "name": "status",
            "in": "query",
            "explode": false,
            "schema": {
              "enum": [
                "active",
                "retired"
              ],
              "type": "string"
            }
          },
          {
            "name": "sort",
            "in": "query",
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          {
            "name": "page",
            "in": "query",
            "explode": false,
            "schema": {
              "minimum": 1,
              "type": "integer",
              "format": "int32",
              "default": 1
            }
          },
          {
            "name": "pageSize",
            "in": "query",
            "explode": false,
            "schema": {
              "maximum": 100,
              "minimum": 1,
              "type": "integer",
              "format": "int32",
              "default": 20
            }
          }
        ],
        "responses": {
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PagedOfIngredientSummary"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Cooquoi.Context.Foodpedia.Features.CreateIngredient.CreateIngredientEndpoint"
        ],
        "summary": "C1: a curator adds an ingredient; search finds it once the projection ran.",
        "description": "POST_v1_ingredients",
        "operationId": "createIngredient",
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateIngredient"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Created",
            "headers": {
              "Location": {
                "required": true,
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreatedIngredient"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "409": {
            "description": "Conflict",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "422": {
            "description": "Unprocessable Entity",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/v1/ingredients/{ingredientId}": {
      "get": {
        "tags": [
          "Cooquoi.Context.Foodpedia.Features.GetIngredient.GetIngredientEndpoint"
        ],
        "summary": "Q2: one ingredient, name in the `Accept-Language` locale (English fallback); `ETag` = version.",
        "description": "GET_v1_ingredients_ingredientId",
        "operationId": "getIngredient",
        "parameters": [
          {
            "name": "ingredientId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "200": {
            "description": "OK",
            "headers": {
              "ETag": {
                "required": true,
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IngredientDetail"
                }
              }
            }
          }
        }
      }
    },
    "/v1/ingredients/{ingredientId}:define-conversion": {
      "post": {
        "tags": [
          "Cooquoi.Context.Foodpedia.Features.DefineConversion.DefineConversionEndpoint"
        ],
        "summary": "C5: replace-style, so the client proves which version it edited (If-Match); answers the new version as ETag.",
        "description": "POST_v1_ingredients_ingredientId",
        "operationId": "defineConversion",
        "parameters": [
          {
            "name": "ingredientId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "If-Match",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DefineConversion"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "No Content",
            "headers": {
              "ETag": {
                "required": true,
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "409": {
            "description": "Conflict",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "412": {
            "description": "Precondition Failed",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "422": {
            "description": "Unprocessable Entity",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "428": {
            "description": "Precondition Required",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ConversionDetail": {
        "required": [
          "unit",
          "unitAmount",
          "baseAmount"
        ],
        "type": "object",
        "properties": {
          "unit": {
            "enum": [
              "g",
              "kg",
              "ml",
              "l",
              "tsp",
              "tbsp",
              "cup",
              "piece",
              "pack",
              "can",
              "bottle",
              "slice",
              "fillet",
              "clove",
              "bunch",
              "pinch"
            ],
            "type": "string"
          },
          "unitAmount": {
            "type": "number",
            "format": "decimal"
          },
          "baseAmount": {
            "type": "number",
            "format": "decimal"
          }
        }
      },
      "ConversionInput": {
        "required": [
          "unit",
          "unitAmount",
          "baseAmount"
        ],
        "type": "object",
        "properties": {
          "unit": {
            "enum": [
              "g",
              "kg",
              "ml",
              "l",
              "tsp",
              "tbsp",
              "cup",
              "piece",
              "pack",
              "can",
              "bottle",
              "slice",
              "fillet",
              "clove",
              "bunch",
              "pinch"
            ],
            "type": "string"
          },
          "unitAmount": {
            "type": "number",
            "format": "decimal"
          },
          "baseAmount": {
            "type": "number",
            "format": "decimal"
          }
        }
      },
      "CreateIngredient": {
        "required": [
          "code",
          "names",
          "baseUnit",
          "tags"
        ],
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "names": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Name"
            }
          },
          "baseUnit": {
            "enum": [
              "g",
              "ml",
              "piece"
            ],
            "type": "string"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "conversions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ConversionInput"
            }
          },
          "shelfLife": {
            "required": [
              "days",
              "recommendedStorage"
            ],
            "type": "object",
            "properties": {
              "days": {
                "type": "integer",
                "format": "int32"
              },
              "recommendedStorage": {
                "enum": [
                  "fridge",
                  "freezer",
                  "room"
                ],
                "type": "string"
              }
            }
          }
        },
        "description": "C1: body of `POST /v1/ingredients`."
      },
      "CreatedIngredient": {
        "required": [
          "id"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "DefineConversion": {
        "required": [
          "unit",
          "unitAmount",
          "baseAmount"
        ],
        "type": "object",
        "properties": {
          "unit": {
            "enum": [
              "g",
              "kg",
              "ml",
              "l",
              "tsp",
              "tbsp",
              "cup",
              "piece",
              "pack",
              "can",
              "bottle",
              "slice",
              "fillet",
              "clove",
              "bunch",
              "pinch"
            ],
            "type": "string"
          },
          "unitAmount": {
            "type": "number",
            "format": "decimal"
          },
          "baseAmount": {
            "type": "number",
            "format": "decimal"
          }
        },
        "description": "C5: body of `POST /v1/ingredients/{id}:define-conversion`; requires `If-Match`."
      },
      "FieldError": {
        "required": [
          "field",
          "code"
        ],
        "type": "object",
        "properties": {
          "field": {
            "type": "string"
          },
          "code": {
            "enum": [
              "validation.required",
              "validation.max-length",
              "validation.min-length",
              "validation.min",
              "validation.max",
              "validation.range",
              "validation.pattern",
              "validation.invalid",
              "validation.one-of"
            ],
            "type": "string"
          },
          "params": {
            "type": "object",
            "additionalProperties": { }
          }
        }
      },
      "IngredientDetail": {
        "required": [
          "id",
          "code",
          "locale",
          "name",
          "synonyms",
          "baseUnit",
          "conversions",
          "shelfLife",
          "tags",
          "status",
          "version"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "code": {
            "type": "string"
          },
          "locale": {
            "enum": [
              "en",
              "fr",
              "vi"
            ],
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "synonyms": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "baseUnit": {
            "enum": [
              "g",
              "ml",
              "piece"
            ],
            "type": "string"
          },
          "conversions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ConversionDetail"
            }
          },
          "shelfLife": {
            "anyOf": [
              {
                "required": [
                  "days",
                  "recommendedStorage"
                ],
                "type": "object",
                "properties": {
                  "days": {
                    "type": "integer",
                    "format": "int32"
                  },
                  "recommendedStorage": {
                    "enum": [
                      "fridge",
                      "freezer",
                      "room"
                    ],
                    "type": "string"
                  }
                }
              },
              {
                "type": "null"
              }
            ]
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "status": {
            "enum": [
              "active",
              "retired"
            ],
            "type": "string"
          },
          "version": {
            "type": "integer",
            "format": "int64"
          }
        },
        "description": "Q2: one ingredient in the requested locale; long IngredientDetail.Version is sent back as `If-Match`."
      },
      "IngredientSummary": {
        "required": [
          "id",
          "code",
          "name",
          "baseUnit",
          "categoryTags"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "code": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "baseUnit": {
            "enum": [
              "g",
              "ml",
              "piece"
            ],
            "type": "string"
          },
          "categoryTags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "description": "One search result; the name is in the requested locale, English when missing."
      },
      "MeHousehold": {
        "required": [
          "id",
          "name",
          "role"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "role": {
            "enum": [
              "owner",
              "member"
            ],
            "type": "string"
          }
        }
      },
      "MeProfile": {
        "required": [
          "userId",
          "displayName",
          "email",
          "locale",
          "defaultHouseholdId"
        ],
        "type": "object",
        "properties": {
          "userId": {
            "type": "string",
            "format": "uuid"
          },
          "displayName": {
            "type": "string"
          },
          "email": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "locale": {
            "enum": [
              "en",
              "fr",
              "vi"
            ],
            "type": "string"
          },
          "defaultHouseholdId": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "MeResponse": {
        "required": [
          "profile",
          "households"
        ],
        "type": "object",
        "properties": {
          "profile": {
            "$ref": "#/components/schemas/MeProfile"
          },
          "households": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MeHousehold"
            }
          }
        },
        "description": "Response of `GET /v1/me`, matching the contract (contracts/contexts/household)."
      },
      "Name": {
        "required": [
          "locale",
          "primary"
        ],
        "type": "object",
        "properties": {
          "locale": {
            "enum": [
              "en",
              "fr",
              "vi"
            ],
            "type": "string"
          },
          "primary": {
            "type": "string"
          },
          "synonyms": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "PagedOfIngredientSummary": {
        "required": [
          "items",
          "page",
          "pageSize",
          "totalCount"
        ],
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/IngredientSummary"
            }
          },
          "page": {
            "type": "integer",
            "format": "int32"
          },
          "pageSize": {
            "type": "integer",
            "format": "int32"
          },
          "totalCount": {
            "type": "integer",
            "format": "int64"
          }
        },
        "description": "One page of a list query, with the total count of matching items (contract `Page/// One page of a list query, with the total count of matching items.lt;T/// One page of a list query, with the total count of matching items.gt;`)."
      },
      "ProblemDetails": {
        "required": [
          "type",
          "title",
          "status",
          "code"
        ],
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "format": "uri"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "integer",
            "format": "int32"
          },
          "detail": {
            "type": "string"
          },
          "instance": {
            "type": "string"
          },
          "code": {
            "type": "string"
          },
          "params": {
            "type": "object",
            "additionalProperties": { }
          },
          "errors": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/FieldError"
            }
          },
          "traceId": {
            "type": "string"
          }
        }
      },
      "ShelfLifeDetail": {
        "required": [
          "days",
          "recommendedStorage"
        ],
        "type": "object",
        "properties": {
          "days": {
            "type": "integer",
            "format": "int32"
          },
          "recommendedStorage": {
            "enum": [
              "fridge",
              "freezer",
              "room"
            ],
            "type": "string"
          }
        }
      },
      "ShelfLifeInput": {
        "required": [
          "days",
          "recommendedStorage"
        ],
        "type": "object",
        "properties": {
          "days": {
            "type": "integer",
            "format": "int32"
          },
          "recommendedStorage": {
            "enum": [
              "fridge",
              "freezer",
              "room"
            ],
            "type": "string"
          }
        }
      }
    },
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "Bearer"
      }
    }
  },
