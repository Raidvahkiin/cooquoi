{
  "name": "@cooquoi/webapp",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "targets": {
    "docker-build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "docker build -f ts/apps/cooquoi-webapp/Dockerfile -t cooquoi-webapp:{args.tag} .",
        "cwd": "{workspaceRoot}"
      }
    },
    "theme-build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "astryx theme build src/shared/ui/theme/cooquoi.theme.ts",
        "cwd": "{projectRoot}"
      }
    }
  }
}
