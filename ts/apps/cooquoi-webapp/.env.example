# Template for the webapp's environment. Copy to a local file only when running
# the webapp outside Aspire; Aspire sets every variable below, so the AppHost
# run needs no local file. Values are placeholders, not real secrets.
# Local HTTPS: https://localhost:3000 (ADR 0018).

APP_URL=https://localhost:3000
API_BASE_URL=https://localhost:3001
# Upper bound of one API call in milliseconds (optional, default 5000).
COOQUOI_API_TIMEOUT_MS=5000
OIDC_ISSUER=https://localhost:8089/realms/cooquoi
OIDC_CLIENT_ID=cooquoi-webapp
OIDC_CLIENT_SECRET=replace-with-client-secret
# At least 32 characters.
SESSION_PASSWORD=replace-with-at-least-32-characters-long-secret
# Redis session store, as the `webapp` ACL user (aspire/redis/users.acl).
SESSION_STORE_URL=redis://webapp:replace-with-password@localhost:6379
