{
  "name": "@cooquoi/api-client",
  "version": "0.0.0",
  "private": true,
  "description": "TypeScript client generated from the TypeSpec contract (ADR 0009). Never edit src/generated by hand.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "generate": "openapi-ts"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "catalog:"
  },
  "nx": {
    "tags": ["type:lib", "scope:utility", "platform:all"],
    "targets": {
      "generate": {
        "cache": true,
        "dependsOn": ["@cooquoi/contracts:compile"],
        "inputs": ["{workspaceRoot}/contracts/generated/openapi.yaml", "{projectRoot}/openapi-ts.config.ts"],
        "outputs": ["{projectRoot}/src/generated"]
      }
    }
  }
}
