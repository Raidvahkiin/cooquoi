{
  "name": "@cooquoi/contracts",
  "version": "0.0.0",
  "private": true,
  "description": "Cooquoi API contract (TypeSpec, source of truth). Emits OpenAPI to generated/.",
  "scripts": {
    "compile": "tsp compile ."
  },
  "devDependencies": {
    "@typespec/compiler": "catalog:",
    "@typespec/http": "catalog:",
    "@typespec/openapi": "catalog:",
    "@typespec/openapi3": "catalog:"
  },
  "nx": {
    "tags": [
      "type:contract",
      "scope:contract",
      "platform:all"
    ],
    "targets": {
      "compile": {
        "cache": true,
        "inputs": [
          "{projectRoot}/**/*.tsp",
          "{projectRoot}/tspconfig.yaml"
        ],
        "outputs": [
          "{projectRoot}/generated"
        ]
      },
      "drift": {
        "cache": true,
        "dependsOn": [
          "compile",
          "@cooquoi/dotnet:build"
        ],
        "inputs": [
          "{projectRoot}/generated/openapi.yaml",
          "{workspaceRoot}/dotnet/generated/openapi.json",
          "{projectRoot}/scripts/drift-gate.mjs"
        ],
        "executor": "nx:run-commands",
        "options": {
          "cwd": "{workspaceRoot}",
          "command": "docker run --rm -v \"$PWD\":/specs:ro -w /specs tufin/oasdiff:v1.39.0 diff -f json -e description,examples,summary,tags,title contracts/generated/openapi.yaml dotnet/generated/openapi.json | node contracts/scripts/drift-gate.mjs"
        }
      }
    }
  }
}
