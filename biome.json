{
  "$schema": "https://biomejs.dev/schemas/2.6.8/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**",
      "!**/dist",
      "!**/coverage",
      "!**/.nx/cache",
      "!**/.nx/workspace-data",
      "!**/*.md",
      "!**/pnpm-lock.yaml",
      "!**/next-env.d.ts",
      "!legacy",
      "!ts/libs/api-client/src/generated",
      "!contracts/generated",
      "!dotnet/generated",
      "!ts/apps/cooquoi-webapp/src/shared/ui/theme/cooquoi.{css,js,d.ts,css.d.ts}",
      "!dotnet-tools.json",
      "!**/.agents",
      "!**/.cursor",
      "!**/.github/skills",
      "!**/.github/agents",
      "!**/.github/prompts",
      "!**/.opencode",
      "!**/.codex",
      "!**/.gemini",
      "!**/.claude"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single"
    },
    "parser": {
      "unsafeParameterDecoratorsEnabled": true
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "style": {
        "useImportType": "off",
        "noExcessiveLinesPerFile": {
          "level": "error",
          "options": {
            "maxLines": 150,
            "skipBlankLines": true
          }
        }
      },
      "complexity": {
        "noExcessiveCognitiveComplexity": {
          "level": "error",
          "options": {
            "maxAllowedComplexity": 15
          }
        },
        "noExcessiveLinesPerFunction": {
          "level": "error",
          "options": {
            "maxLines": 30,
            "skipBlankLines": true,
            "skipIifes": true
          }
        },
        "useMaxParams": {
          "level": "error",
          "options": {
            "max": 2
          }
        }
      },
      "suspicious": {
        "noImportCycles": "error"
      }
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "overrides": [
    {
      "includes": [
        "**/*.spec.ts",
        "**/*.spec.tsx",
        "**/*.test.ts",
        "**/*.test.tsx"
      ],
      "linter": {
        "rules": {
          "suspicious": {
            "noExplicitAny": "off"
          }
        }
      }
    },
    {
      "includes": [
        "**/*.spec.ts",
        "**/*.spec.tsx",
        "**/*.test.ts",
        "**/*.test.tsx"
      ],
      "linter": {
        "rules": {
          "complexity": {
            "noExcessiveLinesPerFunction": "off",
            "useMaxParams": "off"
          },
          "style": {
            "noExcessiveLinesPerFile": "off"
          }
        }
      }
    },
    {
      "includes": ["ts/apps/cooquoi-webapp/src/app/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@/features/*/*"],
                    "message": "app/ imports a feature only through its barrel: @/features/<x>"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["ts/apps/cooquoi-webapp/src/features/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@/features/*", "@/features/**"],
                    "message": "A feature never imports another feature; pages compose features"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["ts/apps/cooquoi-webapp/src/shared/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@/features", "@/features/**"],
                    "message": "shared/ never imports a feature"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["scripts/**"],
      "linter": {
        "rules": {
          "complexity": {
            "noExcessiveCognitiveComplexity": "off"
          }
        }
      }
    }
  ]
}
