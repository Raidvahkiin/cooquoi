{
  "realm": "cooquoi",
  "displayName": "Cooquoi",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": true,
  "registrationEmailAsUsername": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "verifyEmail": false,
  "rememberMe": true,
  "internationalizationEnabled": true,
  "supportedLocales": ["en", "fr", "vi"],
  "defaultLocale": "en",
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 2592000,
  "ssoSessionMaxLifespan": 2592000,
  "revokeRefreshToken": true,
  "refreshTokenMaxReuse": 0,
  "roles": {
    "realm": [
      {
        "name": "catalog-curator",
        "description": "Maintains Foodpedia (ingredients, units, conversions, tags)"
      }
    ]
  },
  "clients": [
    {
      "clientId": "cooquoi-api",
      "name": "Cooquoi API",
      "description": "Resource server: audience of access tokens; no login flow",
      "enabled": true,
      "publicClient": false,
      "bearerOnly": false,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "implicitFlowEnabled": false
    },
    {
      "clientId": "cooquoi-webapp",
      "name": "Cooquoi webapp",
      "description": "Next.js backend-for-frontend (ADR 0011)",
      "enabled": true,
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${COOQUOI_WEBAPP_CLIENT_SECRET}",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": ["${COOQUOI_WEBAPP_URL}/auth/callback"],
      "webOrigins": ["${COOQUOI_WEBAPP_URL}"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "${COOQUOI_WEBAPP_URL}/*",
        "use.refresh.tokens": "true"
      },
      "protocolMappers": [
        {
          "name": "cooquoi-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "cooquoi-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    }
  ],
  "identityProviders": [
    {
      "alias": "google",
      "displayName": "Google",
      "providerId": "google",
      "enabled": false,
      "trustEmail": true,
      "firstBrokerLoginFlowAlias": "first broker login",
      "config": {
        "clientId": "${GOOGLE_CLIENT_ID:not-configured}",
        "clientSecret": "${GOOGLE_CLIENT_SECRET:not-configured}",
        "syncMode": "IMPORT"
      }
    }
  ]
}
