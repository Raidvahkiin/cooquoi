  "scripts": {
    "start": "SWC_NODE_PROJECT=./tsconfig.json node --no-experimental-strip-types -r @swc-node/register src/main.ts",
    "start:dev": "SWC_NODE_PROJECT=./tsconfig.json node --no-experimental-strip-types -r @swc-node/register --watch src/main.ts",
    "start:debug": "SWC_NODE_PROJECT=./tsconfig.json node --no-experimental-strip-types -r @swc-node/register --inspect --watch src/main.ts",
    "db:push": "drizzle-kit push --force",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage"
  },
  "dependencies": {
    "@cooquoi/market": "workspace:*",
    "@utils/api-contracts": "workspace:*",
    "@utils/nestjs": "workspace:*",
    "@fastify/static": "catalog:",
    "@nestjs/common": "catalog:",
    "@nestjs/config": "catalog:",
    "@nestjs/core": "catalog:",
    "@nestjs/cqrs": "catalog:",
    "@nestjs/platform-fastify": "catalog:",
    "@nestjs/swagger": "catalog:",
    "@swc-node/register": "catalog:",
    "@swc/core": "catalog:",
    "class-transformer": "catalog:",
    "class-validator": "catalog:",
    "dotenv": "catalog:",
    "reflect-metadata": "catalog:",
    "rxjs": "catalog:"
  },
  "devDependencies": {
    "@nestjs/testing": "catalog:",
    "drizzle-kit": "catalog:"
  }
}
