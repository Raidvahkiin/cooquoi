{
  "name": "@cooquoi/monorepo",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "nx:typecheck": "nx run-many --target=typecheck",
    "nx:lint": "nx run-many --target=lint",
    "nx:test": "nx run-many --target=test",
    "nx:format": "biome format . --write",
    "dev:api": "nx run @cooquoi/api:start:dev",
    "dev:webapp": "nx dev @cooquoi/webapp",
    "compose:dev": "docker compose -f docker/dev.docker-compose.yml"
  },
  "private": true,
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@nx/eslint": "24.0.6",
    "@nx/eslint-plugin": "24.0.6",
    "@nx/js": "24.0.6",
    "@nx/next": "24.0.6",
    "@nx/storybook": "24.0.6",
    "@nx/vite": "24.0.6",
    "@nx/vitest": "24.0.6",
    "@nx/web": "24.0.6",
    "@storybook/react": "10.6.8",
    "@storybook/react-vite": "10.6.8",
    "@swc-node/register": "catalog:",
    "@swc/core": "catalog:",
    "@swc/helpers": "0.5.24",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^10.15.0",
    "jsdom": "^31.0.1",
    "nx": "24.0.6",
    "rimraf": "^6.1.4",
    "storybook": "10.6.8",
    "tailwindcss": "^4.3.5",
    "tslib": "^2.9.1",
    "tsx": "^4.23.15",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "5.1.1"
  },
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "workspaces": [
    "apps/*",
    "libs/*",
    "libs/**/*",
    "ts/apps/*",
    "ts/libs/**/*"
  ],
  "overrides": {
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  }
}
